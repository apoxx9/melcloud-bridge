# MELCloud Home credentials
MELCLOUD_EMAIL=your-email@example.com
MELCLOUD_PASSWORD=your-password

# Polling interval in seconds (default: 60)
POLL_INTERVAL=60

# API host/port
API_HOST=0.0.0.0
API_PORT=8099

# Reconciliation: re-assert the last commanded state if the device drifts (default: false)
RECONCILE=false
# Where desired state is persisted (mount a volume at /app/data to survive restarts)
DESIRED_STATE_FILE=data/desired_state.json
